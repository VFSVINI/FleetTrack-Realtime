# Copie para .env (make up faz isso automaticamente). Todos os valores têm padrão no docker-compose.yml.

# Infra
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
POSTGRES_DB=fleet
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Observabilidade
LOG_LEVEL=info

# Ingestor
PUBLISHER_WORKERS=8
# MAX_BATCH_SIZE=500
# PUBLISHER_QUEUE_SIZE=10000

# Processor
PROCESSOR_WORKERS=8
BATCH_SIZE=500
BATCH_INTERVAL=1s
SPEED_LIMIT_KMH=100
SPEED_CRITICAL_KMH=120
FUEL_CRITICAL_PCT=15
ALERT_COOLDOWN=1m

# Simulador
SIM_VEHICLES=30
